rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The first admin is created in the Firebase console by setting
    // users/{uid}.role to ADMIN and users/{uid}.status to APPROVED.
    // Clients cannot grant themselves admin access or approval.

    function signedIn() {
      return request.auth != null;
    }

    function userPath(accountId) {
      return /databases/$(database)/documents/users/$(accountId);
    }

    function hasAccount() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function account() {
      return get(userPath(request.auth.uid)).data;
    }

    function isApproved() {
      return hasAccount() && account().status == 'APPROVED';
    }

    function isAdmin() {
      return isApproved() && account().role == 'ADMIN';
    }

    function userKeys() {
      return request.resource.data.keys().hasOnly([
        'uid', 'name', 'email', 'role', 'status', 'createdAt', 'updatedAt'
      ]);
    }

    function sameIdentity() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validTransaction() {
      let data = request.resource.data;
      return data.barcode is string
        && data.barcode.size() > 0
        && data.barcode.size() <= 128
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.reason is string
        && data.reason.size() > 0
        && data.reason.size() <= 300
        && data.action in ['TAKING', 'RETURNING']
        && data.transactionDate is string
        && data.transactionDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.transactionTime is string
        && data.transactionTime.size() > 0
        && data.transactionTime.size() <= 32
        && data.createdAt is timestamp
        && data.createdBy == request.auth.uid;
    }

    function validItem() {
      let data = request.resource.data;
      return data.barcode is string
        && data.barcode.size() > 0
        && data.barcode.size() <= 128
        && data.status in ['AVAILABLE', 'TAKEN']
        && data.lastUpdated is timestamp
        && (data.lastTransactionDate == null || (data.lastTransactionDate is string && data.lastTransactionDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && (
          (data.status == 'TAKEN'
            && data.currentHolder is string
            && data.currentHolder.size() > 0
            && data.currentHolder.size() <= 80
            && data.reason is string
            && data.reason.size() > 0
            && data.reason.size() <= 300
            && data.takenAt is timestamp)
          ||
          (data.status == 'AVAILABLE'
            && data.currentHolder == null
            && data.reason == null
            && data.takenAt == null)
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && userKeys()
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && (request.auth.token.email == null || request.resource.data.email == request.auth.token.email)
        && request.resource.data.role == 'USER'
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.auth.uid != userId
        && userKeys()
        && sameIdentity()
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.status == 'PENDING'
            && resource.data.role == 'USER'
            && request.resource.data.role == 'USER'
            && request.resource.data.status in ['APPROVED', 'REJECTED'])
          ||
          (resource.data.status == 'APPROVED'
            && request.resource.data.status == 'APPROVED'
            && request.resource.data.role in ['ADMIN', 'USER']
            && request.resource.data.role != resource.data.role)
          ||
          (resource.data.status == 'APPROVED'
            && request.resource.data.status == 'REVOKED'
            && request.resource.data.role == resource.data.role)
          ||
          (resource.data.status == 'REVOKED'
            && request.resource.data.status == 'APPROVED'
            && request.resource.data.role == resource.data.role)
        );

      allow delete: if false;
    }

    match /transactions/{id} {
      allow read: if isApproved();
      allow create: if isApproved() && validTransaction();
      allow update, delete: if false;
    }

    match /items/{id} {
      allow read: if isApproved();
      allow create, update: if isApproved() && validItem();
      allow delete: if false;
    }
  }
}
